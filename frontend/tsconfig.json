{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/widgets": ["../../shared-canonical-services/shared/widgets/react"],
      "@shared/widgets/*": ["../../shared-canonical-services/shared/widgets/react/*"]
    }
  },
  "include": ["src"]
}
