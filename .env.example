# Vertical Spine Kit — satellite stack behind the snapford.com Traefik edge.

# ── Routing ──────────────────────────────────────────────────────────
TRAEFIK_HOST=vertical-spine-kit.snapford.com
CORS_ORIGINS=https://vertical-spine-kit.snapford.com,https://snapford.com
# Base domain for cookie scoping and hub links (all verticals share *.snapford.com).
SNAPFORD_BASE_DOMAIN=snapford.com
# This product's ID for hub entitlements, checkout, and metrics.
SNAPFORD_PRODUCT_ID=vertical-spine-kit

# ── Identity: hub at snapford.com/auth is the canonical SSO ────────
# Container-internal URL of the account hub (snapford-web's hub service).
SNAPFORD_HUB_INTERNAL_URL=http://hub:8153
# JWT secret — MUST match the hub's JWT_SECRET_KEY (shared identity).
JWT_SECRET_KEY=${JWT_SECRET_KEY:?set a long random JWT secret (same as hub)}
# Auth cookie domain: parent domain so all *.snapford.com share the session.
AUTH_COOKIE_DOMAIN=.snapford.com

# ── Database ─────────────────────────────────────────────────────────
# sqlite (default, zero-config): file at DB_PATH (data/<slug>.db)
# postgres: docker compose --profile postgres up -d
DB_ENGINE=sqlite
DB_PATH=data/vertical-spine-kit.db
POSTGRES_USER=vertical-spine-kit
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?set a strong Postgres password (postgres profile only)}
POSTGRES_DB=vertical-spine-kit_saas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Payments: ALL providers from shared.billing / shared.payments ───
# The UnifiedPaymentService auto-detects which providers are configured
# (any subset of the 18: adyen airwallex creem dodo fastspring fondy
# freemius liqpay mono novapay paddle payoneer_checkout paypal
# paypro_global rozetkapay stripe verifone wayforpay).
# Set credentials for ONLY the providers you use; the rest stay dormant.

# Stripe (most common)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_vertical-spine-kitUPPERCASED__=          # per-product Price ID

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                            # or live

# Paddle
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_PUBLIC_KEY=

# Adyen
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CLIENT_KEY=
ADYEN_HMAC_KEY=

# Wayforpay / Fondy / LiqPay / Mono / NovaPay / RozetkaPay (regional)
# See shared/payments/<provider>.py for each provider's env vars.

# Checkout mode: payment (one-time) or subscription (recurring)
CHECKOUT_MODE=subscription

# ── Metrics feed ────────────────────────────────────────────────────
# Report per-product KPIs to the hub's business-metrics feed (hourly).
METRICS_FEED=1
METRICS_FEED_INTERVAL=3600
