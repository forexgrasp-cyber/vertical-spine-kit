# Public host of this product (routed by the shared Traefik edge).
TRAEFIK_HOST=callagent.snapford.com

# Secrets live in .env (never commit it); this file only documents the keys.
# Fill real values on the VPS via deploy/vps/server_bootstrap.sh + manual edit.

# ── Required ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=                       # must match the hub (SSO cookie trust)
PII_ENCRYPTION_KEY=                   # Fernet key; without it PII is stored PLAINTEXT (boot warns)
APP_SECRET_KEY=                       # FastAPI session signing
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=                       # LLM intent extraction (keyword fallback works without it)

# ── Storage (defaults fine for SQLite satellite) ───────────────────────
DB_ENGINE=sqlite                      # sqlite | postgres
DATABASE_URL=sqlite:///data/callagent.db
VOICE_AGENT_DATABASE_URL=             # overrides DATABASE_URL for voice tables when set
ENTITLEMENTS_DB_PATH=data/entitlements.db
REDIS_URL=redis://redis:6379/0

# ── Product / edge ──────────────────────────────────────────────────────
SNAPFORD_PRODUCT_ID=callagent
SNAPFORD_BASE_DOMAIN=snapford.com
SNAPFORD_HUB_INTERNAL_URL=http://hub:8153
CORS_ORIGINS=https://callagent.snapford.com,https://snapford.com
BASE_URL=https://callagent.snapford.com
OG_IMAGE=https://callagent.snapford.com/og-image.png
APP_ENV=production                    # hides /docs /redoc when set to production

# ── Voice agent tuning (optional) ───────────────────────────────────────
VOICE_COST_PER_MINUTE=0.10
VOICE_WEBHOOK_RATE_LIMIT=60           # per-tenant webhook requests/minute
VOICE_AGENT_BASE_URL=https://callagent.snapford.com

# ── Licenses (digital-product keys, optional) ───────────────────────────
LICENSE_SIGNING_SECRET=
LICENSE_STORE_PATH=data/license_keys.json

# ── Deploy plumbing (compose interpolation only) ────────────────────────
SITE_ENV_FILE=.env
POSTGRES_USER=callagent
POSTGRES_PASSWORD=
POSTGRES_DB=callagent_saas
